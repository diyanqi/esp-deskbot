# HTTP listener
LISTEN_ADDR=:11294
# Set both to serve HTTPS directly. For HTTP behind a reverse proxy, leave empty.
TLS_CERT_FILE=
TLS_KEY_FILE=

# IoTDA HTTP push authentication (must match the token in the IoTDA console)
IOTDA_PUSH_TOKEN=change-me
IOTDA_SIGNATURE_MAX_AGE=10m
DEV_ALLOW_UNSIGNED_PUSH=false

# Bearer token for /api/v1/*. Leave empty only for local development.
API_TOKEN=change-me

# Comma-separated browser origins allowed to call the query API, or "*" for
# local demos. Use explicit origins in production.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:4173

# PostgreSQL
DATABASE_URL=postgres://data_collect:change-me@127.0.0.1:5432/data_collect?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=1
DB_MAX_CONN_LIFETIME=30m
DB_CONNECT_TIMEOUT=10s
RUN_MIGRATIONS=true

# HTTP timeouts
HTTP_READ_TIMEOUT=15s
# AI reports can take up to AI_TIMEOUT (45s), so keep this above it.
HTTP_WRITE_TIMEOUT=60s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_MAX_BODY_BYTES=5242880

# AI health report (OpenAI-compatible chat completions)
AI_ENABLED=true
AI_API_URL=https://ch.at/v1/chat/completions
AI_MODEL=gpt-4o
AI_API_KEY=
AI_TIMEOUT=45s

# Scenario injection endpoint. Keep false outside demos.
DEMO_ENABLED=false

# Logging
LOG_LEVEL=info
LOG_JSON=false
