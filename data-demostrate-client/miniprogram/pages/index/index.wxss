.page {
  position: relative;
  min-height: 100vh;
  background: #05070c;
  color: #e6edf7;
  overflow: hidden;
}

.ambient {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 0;
}

.ambient-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(90rpx);
}

.orb-a {
  width: 560rpx;
  height: 560rpx;
  left: -180rpx;
  top: -140rpx;
  background: rgba(34, 211, 238, 0.2);
}

.orb-b {
  width: 520rpx;
  height: 520rpx;
  right: -180rpx;
  top: 320rpx;
  background: rgba(167, 139, 250, 0.17);
}

.orb-c {
  width: 600rpx;
  height: 600rpx;
  left: 120rpx;
  top: 1500rpx;
  background: rgba(52, 211, 153, 0.1);
}

.nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 30;
  padding-left: 28rpx;
  padding-right: 28rpx;
  background: rgba(5, 7, 12, 0.72);
  border-bottom: 1rpx solid rgba(148, 163, 184, 0.12);
  backdrop-filter: blur(28rpx) saturate(140%);
  -webkit-backdrop-filter: blur(28rpx) saturate(140%);
}

.nav-inner {
  position: relative;
  display: flex;
  align-items: center;
  height: 88rpx;
}

.brand {
  display: flex;
  align-items: center;
  min-width: 0;
}

.brand-mark {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(34, 211, 238, 0.3);
  background: radial-gradient(circle at 35% 30%, rgba(34, 211, 238, 0.28), rgba(124, 58, 237, 0.1) 66%, transparent);
  box-shadow: 0 0 30rpx rgba(34, 211, 238, 0.14);
  flex: none;
}

.brand-mark::before {
  content: '';
  position: absolute;
  left: 12rpx;
  right: 12rpx;
  top: 20rpx;
  bottom: 20rpx;
  border: 2rpx solid rgba(34, 211, 238, 0.66);
  border-radius: 50%;
  transform: rotate(-10deg);
}

.brand-mark::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  background: radial-gradient(circle at 35% 35%, #a5f3fc, #0891b2 60%, #4c1d95);
  box-shadow: 0 0 22rpx rgba(34, 211, 238, 0.8);
}

.brand-pupil {
  position: absolute;
  left: 30rpx;
  top: 27rpx;
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.8);
  z-index: 2;
}

.brand-copy {
  display: flex;
  flex-direction: column;
  margin-left: 16rpx;
  min-width: 0;
}

.brand-kicker {
  color: #5b6b82;
  font-size: 14rpx;
  letter-spacing: 2rpx;
}

.brand-title-row {
  display: flex;
  align-items: center;
  margin-top: 3rpx;
}

.brand-title {
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: -1rpx;
  line-height: 1.1;
}

.parent-badge {
  margin-left: 10rpx;
  padding: 3rpx 10rpx;
  border: 1rpx solid rgba(52, 211, 153, 0.3);
  border-radius: 999rpx;
  background: rgba(52, 211, 153, 0.08);
  color: #a7f3d0;
  font-size: 14rpx;
}

.brand-sub {
  margin-top: 2rpx;
  color: #8b9bb4;
  font-size: 18rpx;
}

.nav-actions {
  position: absolute;
  display: flex;
  align-items: center;
}

.nav-icon {
  width: 62rpx;
  height: 62rpx;
  margin-left: 12rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.18);
  border-radius: 50%;
  background: rgba(148, 163, 184, 0.06);
  color: #dbe7f7;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-icon:active {
  background: rgba(34, 211, 238, 0.14);
  color: #a5f3fc;
}

.tab-scroll {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100vh;
  box-sizing: border-box;
}

.content {
  padding: 22rpx 24rpx calc(170rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.network-banner,
.error-banner {
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid rgba(251, 113, 133, 0.25);
  border-radius: 16rpx;
  background: rgba(251, 113, 133, 0.08);
  color: #fecdd3;
  font-size: 20rpx;
}

.network-banner {
  border-color: rgba(251, 191, 36, 0.25);
  background: rgba(251, 191, 36, 0.07);
  color: #fde68a;
}

.card {
  position: relative;
  margin-bottom: 20rpx;
  padding: 26rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.14);
  border-radius: 30rpx;
  background: linear-gradient(180deg, rgba(13, 20, 33, 0.86), rgba(7, 11, 19, 0.94));
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.32);
  overflow: hidden;
  animation: fadeUp 0.35s ease both;
}

.card::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(34, 211, 238, 0.32), rgba(167, 139, 250, 0.22), transparent);
}

.card-head {
  display: flex;
  flex-direction: column;
}

.kicker {
  color: #5b6b82;
  font-size: 16rpx;
  letter-spacing: 2.2rpx;
}

.card-title {
  margin-top: 8rpx;
  color: #e6edf7;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: -0.4rpx;
}

.card-sub {
  margin-top: 8rpx;
  color: #8b9bb4;
  font-size: 20rpx;
  line-height: 1.5;
}

.card-head + view,
.card-head + text,
.card-head + scroll-view {
  margin-top: 18rpx;
}

.center-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 50rpx 26rpx;
}

.center-text {
  margin-top: 18rpx;
  color: #8b9bb4;
  font-size: 22rpx;
}

.spinner {
  width: 42rpx;
  height: 42rpx;
  border: 3rpx solid rgba(34, 211, 238, 0.15);
  border-top-color: #22d3ee;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}

.empty-card,
.ai-cta {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 40rpx 26rpx;
}

.empty-icon {
  color: #22d3ee;
  font-size: 54rpx;
  margin-bottom: 12rpx;
}

.empty-title {
  color: #e6edf7;
  font-size: 28rpx;
  font-weight: 600;
}

.empty-desc {
  margin-top: 10rpx;
  color: #8b9bb4;
  font-size: 20rpx;
  line-height: 1.6;
}

.empty-url {
  margin-top: 10rpx;
  color: #5b6b82;
  font-size: 18rpx;
  word-break: break-all;
}

.empty-actions {
  display: flex;
  margin-top: 20rpx;
}

.empty-actions button {
  margin-right: 14rpx;
}

.empty-text {
  padding: 20rpx 0;
  color: #5b6b82;
  font-size: 22rpx;
}

.error-text {
  display: block;
  margin-top: 12rpx;
  color: #fecdd3;
  font-size: 20rpx;
  line-height: 1.5;
}

/* Child strip */
.child-strip {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid rgba(251, 191, 36, 0.16);
  border-radius: 24rpx;
  background: linear-gradient(90deg, rgba(251, 191, 36, 0.07), rgba(251, 113, 133, 0.03));
}

.child-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(251, 191, 36, 0.35);
  background: radial-gradient(circle at 35% 30%, rgba(251, 191, 36, 0.4), rgba(251, 113, 133, 0.15));
  color: #fef3c7;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.child-copy {
  display: flex;
  flex-direction: column;
  margin-left: 16rpx;
  min-width: 0;
}

.child-name {
  color: #e6edf7;
  font-size: 26rpx;
  font-weight: 600;
}

.child-meta {
  margin-top: 4rpx;
  color: #5b6b82;
  font-size: 18rpx;
}

.live-block {
  margin-left: auto;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.live-label {
  color: #34d399;
  font-size: 16rpx;
  letter-spacing: 1.4rpx;
}

.live-time {
  margin-top: 4rpx;
  color: #8b9bb4;
  font-size: 18rpx;
}

/* Controls */
.control-row {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.device-picker {
  flex: 1;
  min-width: 0;
  margin-right: 14rpx;
}

.picker-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 68rpx;
  padding: 0 22rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  border-radius: 999rpx;
  background: rgba(148, 163, 184, 0.05);
}

.picker-text {
  color: #dbe7f7;
  font-size: 22rpx;
  max-width: 320rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.picker-chevron {
  color: #5b6b82;
  font-size: 24rpx;
  margin-left: 10rpx;
}

.range-row {
  display: flex;
  align-items: center;
  flex: none;
}

.range-chip {
  margin-left: 8rpx;
  padding: 9rpx 12rpx;
  border-radius: 12rpx;
  background: rgba(148, 163, 184, 0.06);
  color: #8b9bb4;
  font-size: 18rpx;
}

.range-chip.active {
  background: rgba(34, 211, 238, 0.14);
  color: #a5f3fc;
  border: 1rpx solid rgba(34, 211, 238, 0.3);
}

/* Face */
.hero-body {
  display: flex;
  align-items: flex-start;
  margin-top: 18rpx;
}

.face {
  position: relative;
  width: 210rpx;
  height: 210rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(148, 163, 184, 0.45);
  background: radial-gradient(circle at 50% 35%, #0d1a2b, #070d16 72%);
  flex: none;
  overflow: hidden;
}

.face-ring {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  top: 18rpx;
  bottom: 18rpx;
  border-radius: 50%;
  border: 10rpx solid rgba(148, 163, 184, 0.1);
}

.face-eyes {
  position: absolute;
  left: 0;
  right: 0;
  top: 66rpx;
  display: flex;
  justify-content: center;
}

.face-eye {
  width: 22rpx;
  height: 38rpx;
  margin: 0 20rpx;
  border-radius: 50%;
  background: #94a3b8;
  animation: blink 3.4s infinite;
  transform-origin: center;
}

.face-mouth {
  position: absolute;
  left: 50%;
  top: 132rpx;
  width: 46rpx;
  height: 22rpx;
  margin-left: -23rpx;
  border-bottom: 4rpx solid #94a3b8;
  border-radius: 0 0 50% 50%;
}

.face-good {
  border-color: rgba(52, 211, 153, 0.58);
  box-shadow: 0 0 40rpx rgba(52, 211, 153, 0.1);
}
.face-good .face-eye {
  background: #34d399;
}
.face-good .face-mouth {
  border-bottom-color: #34d399;
}

.face-warning {
  border-color: rgba(251, 191, 36, 0.58);
  box-shadow: 0 0 40rpx rgba(251, 191, 36, 0.1);
}
.face-warning .face-eye {
  background: #fbbf24;
}
.face-warning .face-mouth {
  border-bottom-color: #fbbf24;
  border-radius: 0;
  height: 8rpx;
}

.face-bad {
  border-color: rgba(251, 113, 133, 0.62);
  box-shadow: 0 0 42rpx rgba(251, 113, 133, 0.12);
}
.face-bad .face-eye {
  background: #fb7185;
}
.face-bad .face-mouth {
  top: 142rpx;
  border-bottom: none;
  border-top: 4rpx solid #fb7185;
  border-radius: 50% 50% 0 0;
}

.face-unknown {
  opacity: 0.72;
}
.face-unknown .face-eye {
  height: 8rpx;
  background: #94a3b8;
  animation: none;
}
.face-unknown .face-mouth {
  border-bottom: none;
  height: 4rpx;
  background: #94a3b8;
}

.hero-copy {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 12rpx;
  border: 1rpx solid;
  border-radius: 999rpx;
  font-size: 16rpx;
}

.status-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin-right: 6rpx;
  animation: pulse 2s infinite;
}

.status-label {
  font-weight: 600;
  letter-spacing: 1rpx;
}

.status-zh {
  margin-left: 6rpx;
  color: #8b9bb4;
  font-size: 16rpx;
}

.hero-title {
  margin-top: 12rpx;
  color: #e6edf7;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.35;
}

.hero-desc {
  margin-top: 10rpx;
  color: #8b9bb4;
  font-size: 20rpx;
  line-height: 1.5;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  margin-top: 10rpx;
}

.chip {
  margin-right: 8rpx;
  margin-bottom: 6rpx;
  padding: 5rpx 10rpx;
  border-radius: 10rpx;
  background: rgba(148, 163, 184, 0.07);
  color: #8b9bb4;
  font-size: 16rpx;
}

.chip-ok {
  color: #34d399;
  background: rgba(52, 211, 153, 0.08);
}

.chip-alert {
  color: #fb7185;
  background: rgba(251, 113, 133, 0.1);
}

.chip-light {
  color: #fbbf24;
  background: rgba(251, 191, 36, 0.08);
}

.timeline-strip {
  display: flex;
  height: 12rpx;
  margin-top: 18rpx;
  border-radius: 4rpx;
  overflow: hidden;
}

.timeline-seg {
  flex: 1;
  min-width: 2rpx;
  margin-right: 1rpx;
}

.device-meta {
  display: flex;
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(148, 163, 184, 0.1);
  color: #5b6b82;
  font-size: 16rpx;
}

.device-meta text {
  margin-right: 22rpx;
}

/* Frame */
.frame-tags {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.tag {
  margin-right: 8rpx;
  padding: 5rpx 10rpx;
  border: 1rpx solid rgba(34, 211, 238, 0.22);
  border-radius: 10rpx;
  background: rgba(34, 211, 238, 0.06);
  color: #a5f3fc;
  font-size: 16rpx;
}

.tag-green {
  border-color: rgba(52, 211, 153, 0.22);
  background: rgba(52, 211, 153, 0.06);
  color: #a7f3d0;
}

.frame-count {
  margin-left: auto;
  color: #5b6b82;
  font-size: 16rpx;
}

.frame-stage {
  position: relative;
  margin-top: 14rpx;
  border: 1rpx solid rgba(34, 211, 238, 0.14);
  border-radius: 22rpx;
  background: #020409;
  overflow: hidden;
}

.frame-image {
  display: block;
  width: 100%;
}

.frame-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 340rpx;
  padding: 24rpx;
  text-align: center;
}

.frame-empty-icon {
  color: #5b6b82;
  font-size: 54rpx;
  margin-bottom: 12rpx;
}

.frame-empty-title {
  color: #e6edf7;
  font-size: 24rpx;
}

.frame-empty-hint {
  margin-top: 8rpx;
  color: #5b6b82;
  font-size: 18rpx;
}

.frame-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 28rpx 18rpx 16rpx;
  background: linear-gradient(transparent, rgba(2, 5, 10, 0.92));
}

.overlay-status {
  font-size: 18rpx;
  font-weight: 600;
}

.overlay-summary {
  flex: 1;
  margin-left: 10rpx;
  color: #e6edf7;
  font-size: 20rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.overlay-time {
  margin-left: 10rpx;
  color: #8b9bb4;
  font-size: 16rpx;
}

.frame-strip {
  margin-top: 14rpx;
  white-space: nowrap;
}

.frame-item {
  display: inline-flex;
  flex-direction: column;
  margin-right: 10rpx;
  padding: 10rpx 14rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.12);
  border-radius: 14rpx;
  background: rgba(148, 163, 184, 0.04);
}

.frame-item.selected {
  border-color: rgba(34, 211, 238, 0.4);
  background: rgba(34, 211, 238, 0.08);
}

.frame-item-top {
  display: flex;
  align-items: center;
  color: #e6edf7;
  font-size: 20rpx;
}

.frame-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin-right: 6rpx;
}

.frame-item-status {
  margin-top: 4rpx;
  color: #5b6b82;
  font-size: 14rpx;
  letter-spacing: 1rpx;
}

/* Score */
.score-row {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.score-ring {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.score-ring-inner {
  width: 152rpx;
  height: 152rpx;
  border-radius: 50%;
  background: #0a111c;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.score-num {
  font-size: 58rpx;
  font-weight: 600;
  line-height: 1;
}

.score-label {
  margin-top: 6rpx;
  color: #5b6b82;
  font-size: 16rpx;
}

.score-copy {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.score-level {
  padding: 4rpx 10rpx;
  border: 1rpx solid;
  border-radius: 999rpx;
  font-size: 16rpx;
}

.score-headline {
  margin-top: 10rpx;
  color: #e6edf7;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.35;
}

.score-summary {
  margin-top: 8rpx;
  color: #8b9bb4;
  font-size: 19rpx;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.score-copy .btn-primary {
  margin-top: 12rpx;
}

.mini-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.mini-stat {
  width: calc(50% - 6rpx);
  margin-right: 12rpx;
  margin-bottom: 12rpx;
  padding: 14rpx;
  border-radius: 16rpx;
  background: rgba(148, 163, 184, 0.05);
  display: flex;
  flex-direction: column;
}

.mini-stat:nth-child(2n) {
  margin-right: 0;
}

.mini-label {
  color: #5b6b82;
  font-size: 16rpx;
}

.mini-value {
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.mini-hint {
  margin-top: 4rpx;
  color: #5b6b82;
  font-size: 14rpx;
}

/* Metrics */
.metric-grid {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}

.metric-card {
  width: calc(50% - 6rpx);
  margin-right: 12rpx;
  margin-bottom: 12rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.12);
  border-radius: 22rpx;
  background: linear-gradient(180deg, rgba(13, 20, 33, 0.82), rgba(7, 11, 19, 0.92));
}

.metric-card:nth-child(2n) {
  margin-right: 0;
}

.metric-head {
  display: flex;
  align-items: center;
}

.metric-icon {
  font-size: 26rpx;
  margin-right: 8rpx;
}

.metric-label {
  color: #8b9bb4;
  font-size: 18rpx;
}

.live-mini {
  margin-left: auto;
  padding: 2rpx 6rpx;
  border: 1rpx solid rgba(34, 211, 238, 0.22);
  border-radius: 999rpx;
  color: #22d3ee;
  font-size: 12rpx;
}

.metric-value-row {
  display: flex;
  align-items: baseline;
  margin-top: 12rpx;
}

.metric-value {
  color: #e6edf7;
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1;
}

.metric-unit {
  margin-left: 6rpx;
  color: #5b6b82;
  font-size: 16rpx;
}

.metric-hint {
  display: block;
  margin-top: 8rpx;
  color: #5b6b82;
  font-size: 15rpx;
}

/* Light chart */
.light-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.light-trace {
  color: #5b6b82;
  font-size: 14rpx;
  letter-spacing: 1.4rpx;
}

.light-count {
  color: #5b6b82;
  font-size: 16rpx;
}

.chart-stats {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.chart-stat {
  display: flex;
  flex-direction: column;
  margin-right: 28rpx;
}

.stat-label {
  color: #5b6b82;
  font-size: 14rpx;
  letter-spacing: 1rpx;
}

.stat-value {
  margin-top: 2rpx;
  color: #e6edf7;
  font-size: 24rpx;
}

/* Mix */
.mix-bar {
  display: flex;
  height: 16rpx;
  margin-top: 18rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: rgba(148, 163, 184, 0.08);
}

.mix-seg {
  height: 100%;
}

.mix-legend {
  margin-top: 16rpx;
}

.mix-row {
  display: flex;
  align-items: center;
  padding: 6rpx 0;
}

.mix-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}

.mix-name {
  flex: 1;
  color: #8b9bb4;
  font-size: 19rpx;
}

.mix-count {
  color: #e6edf7;
  font-size: 19rpx;
  margin-right: 18rpx;
}

.mix-percent {
  width: 70rpx;
  color: #5b6b82;
  font-size: 18rpx;
  text-align: right;
}

/* Events */
.event-row {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(148, 163, 184, 0.08);
}

.event-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-top: 8rpx;
  margin-right: 12rpx;
  flex: none;
}

.event-main {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.event-title {
  color: #e6edf7;
  font-size: 21rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.event-meta {
  margin-top: 4rpx;
  color: #5b6b82;
  font-size: 16rpx;
}

/* AI report */
.loading-row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
}

.loading-row .spinner {
  margin-right: 16rpx;
}

.loading-row text {
  color: #8b9bb4;
  font-size: 20rpx;
}

.ai-hero {
  display: flex;
  align-items: flex-start;
  margin-top: 18rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(167, 139, 250, 0.18);
  border-radius: 20rpx;
  background: linear-gradient(120deg, rgba(167, 139, 250, 0.1), rgba(34, 211, 238, 0.03));
}

.ai-score {
  width: 140rpx;
  height: 140rpx;
  border: 2rpx solid;
  border-radius: 50%;
  background: rgba(5, 9, 16, 0.4);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: none;
}

.ai-score-num {
  font-size: 52rpx;
  font-weight: 600;
  line-height: 1;
}

.ai-score-label {
  margin-top: 4rpx;
  color: #5b6b82;
  font-size: 14rpx;
}

.ai-copy {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
  display: flex;
  flex-direction: column;
}

.ai-level-row {
  display: flex;
  align-items: center;
}

.ai-level {
  padding: 3rpx 8rpx;
  border: 1rpx solid rgba(167, 139, 250, 0.28);
  border-radius: 999rpx;
  color: #ddd6fe;
  font-size: 15rpx;
}

.ai-window {
  margin-left: 8rpx;
  color: #5b6b82;
  font-size: 14rpx;
  letter-spacing: 1rpx;
}

.ai-headline {
  margin-top: 10rpx;
  color: #e6edf7;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.35;
}

.ai-summary {
  margin-top: 8rpx;
  color: #8b9bb4;
  font-size: 19rpx;
  line-height: 1.55;
}

.section-title {
  display: block;
  margin-top: 22rpx;
  margin-bottom: 8rpx;
  color: #22d3ee;
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.finding {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
  border-bottom: 1rpx solid rgba(148, 163, 184, 0.07);
}

.finding-bar {
  width: 5rpx;
  height: 54rpx;
  border-radius: 4rpx;
  margin-right: 12rpx;
  flex: none;
}

.finding-main {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.finding-title {
  color: #e6edf7;
  font-size: 21rpx;
  font-weight: 600;
}

.finding-detail {
  margin-top: 4rpx;
  color: #8b9bb4;
  font-size: 18rpx;
  line-height: 1.5;
}

.risk-chips {
  display: flex;
  flex-wrap: wrap;
}

.risk-chip {
  margin-right: 10rpx;
  margin-bottom: 8rpx;
  padding: 6rpx 12rpx;
  border: 1rpx solid rgba(251, 191, 36, 0.24);
  border-radius: 999rpx;
  background: rgba(251, 191, 36, 0.07);
  color: #fde68a;
  font-size: 16rpx;
}

.suggestion {
  display: flex;
  align-items: flex-start;
  padding: 7rpx 0;
}

.suggestion-num {
  width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  border: 1rpx solid rgba(52, 211, 153, 0.25);
  border-radius: 50%;
  color: #a7f3d0;
  font-size: 14rpx;
  text-align: center;
  flex: none;
  margin-right: 10rpx;
}

.suggestion-text {
  flex: 1;
  color: #8b9bb4;
  font-size: 19rpx;
  line-height: 1.55;
}

.encouragement {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border-left: 4rpx solid rgba(251, 113, 133, 0.6);
  border-radius: 0 14rpx 14rpx 0;
  background: rgba(251, 113, 133, 0.06);
  color: #fecdd3;
  font-size: 20rpx;
  line-height: 1.5;
}

.disclaimer {
  display: block;
  margin-top: 14rpx;
  color: #5b6b82;
  font-size: 16rpx;
  line-height: 1.5;
}

.ai-foot {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(148, 163, 184, 0.1);
}

.ai-source {
  flex: 1;
  color: #5b6b82;
  font-size: 16rpx;
}

/* Heatmap */
.heat-tabs {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.heat-tab {
  margin-right: 10rpx;
  padding: 6rpx 12rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.14);
  border-radius: 10rpx;
  color: #8b9bb4;
  font-size: 17rpx;
}

.heat-tab.active {
  border-color: rgba(34, 211, 238, 0.4);
  background: rgba(34, 211, 238, 0.1);
  color: #a5f3fc;
}

.heat-note {
  margin-left: auto;
  color: #5b6b82;
  font-size: 15rpx;
}

.risk-note {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  padding: 12rpx;
  border-radius: 14rpx;
  background: rgba(251, 113, 133, 0.06);
}

.risk-note-icon {
  color: #fb7185;
  font-size: 24rpx;
  margin-right: 10rpx;
}

.risk-note-text {
  flex: 1;
  color: #8b9bb4;
  font-size: 17rpx;
  line-height: 1.4;
}

/* Replay */
.replay-now {
  display: flex;
  align-items: flex-start;
  margin-top: 18rpx;
}

.replay-time-block {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.replay-label {
  color: #5b6b82;
  font-size: 14rpx;
  letter-spacing: 1.4rpx;
}

.replay-clock {
  margin-top: 4rpx;
  color: #e6edf7;
  font-size: 38rpx;
  font-weight: 600;
}

.replay-sub {
  margin-top: 4rpx;
  color: #5b6b82;
  font-size: 16rpx;
}

.replay-status {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.replay-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex: none;
}

.replay-status-label {
  margin-top: 4rpx;
  font-size: 17rpx;
  font-weight: 600;
  letter-spacing: 0.8rpx;
}

.replay-status-zh {
  margin-top: 2rpx;
  color: #5b6b82;
  font-size: 15rpx;
}

.replay-chips {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.replay-segments {
  display: flex;
  height: 16rpx;
  margin-top: 12rpx;
  overflow: hidden;
  border-radius: 4rpx;
}

.replay-seg {
  flex: 1;
  min-width: 2rpx;
  margin-right: 1rpx;
}

.replay-actions {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.replay-speed {
  margin-left: auto;
  color: #5b6b82;
  font-size: 15rpx;
}

.replay-point {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(148, 163, 184, 0.07);
}

.replay-point .replay-dot {
  margin-right: 12rpx;
}

.replay-point-time {
  flex: 1;
  color: #e6edf7;
  font-size: 19rpx;
}

.replay-point-status {
  font-size: 17rpx;
  margin-right: 16rpx;
}

.replay-point-light {
  width: 80rpx;
  color: #5b6b82;
  font-size: 16rpx;
  text-align: right;
}

/* Demo */
.demo-intro {
  display: block;
  margin-top: 16rpx;
  color: #8b9bb4;
  font-size: 19rpx;
  line-height: 1.55;
}

.demo-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.demo-btn {
  width: calc(50% - 6rpx);
  margin-right: 12rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  padding: 14rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.12);
  border-radius: 16rpx;
  background: rgba(148, 163, 184, 0.04);
}

.demo-btn:nth-child(2n) {
  margin-right: 0;
}

.demo-btn.is-disabled {
  opacity: 0.55;
}

.demo-icon {
  width: 44rpx;
  font-size: 28rpx;
  text-align: center;
  margin-right: 8rpx;
}

.demo-copy {
  display: flex;
  flex-direction: column;
}

.demo-label {
  color: #e6edf7;
  font-size: 21rpx;
}

.demo-hint {
  margin-top: 4rpx;
  color: #5b6b82;
  font-size: 14rpx;
}

.demo-auto {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
  padding: 12rpx 16rpx;
  border-radius: 16rpx;
  background: rgba(148, 163, 184, 0.05);
}

.demo-auto-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.demo-auto-title {
  color: #e6edf7;
  font-size: 21rpx;
}

.demo-auto-hint {
  margin-top: 3rpx;
  color: #5b6b82;
  font-size: 15rpx;
}

.demo-message {
  margin-top: 12rpx;
  padding: 12rpx 14rpx;
  border-radius: 12rpx;
  background: rgba(52, 211, 153, 0.07);
  color: #a7f3d0;
  font-size: 17rpx;
  line-height: 1.5;
}

.info-row {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
  border-bottom: 1rpx solid rgba(148, 163, 184, 0.07);
}

.info-label {
  width: 180rpx;
  color: #5b6b82;
  font-size: 18rpx;
  flex: none;
}

.info-value {
  flex: 1;
  color: #22d3ee;
  font-size: 18rpx;
  word-break: break-all;
}

.info-actions {
  display: flex;
  margin-top: 16rpx;
}

.info-actions button {
  margin-right: 12rpx;
}

.auto-refresh-row {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(148, 163, 184, 0.08);
}

.auto-refresh-label {
  flex: 1;
  color: #8b9bb4;
  font-size: 18rpx;
}

.native-row {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(148, 163, 184, 0.07);
}

.native-icon {
  width: 44rpx;
  color: #22d3ee;
  font-size: 26rpx;
  text-align: center;
  margin-right: 10rpx;
}

.native-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.native-title {
  color: #e6edf7;
  font-size: 20rpx;
}

.native-detail {
  margin-top: 3rpx;
  color: #5b6b82;
  font-size: 15rpx;
}

.footer-note {
  padding: 10rpx 0 30rpx;
  color: #3f4b5e;
  font-size: 15rpx;
  text-align: center;
  letter-spacing: 0.6rpx;
}

/* Buttons */
.btn-primary,
.btn-ghost {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  line-height: 1;
  margin: 0;
}

.btn-primary {
  background: #22d3ee;
  color: #041016;
  font-weight: 600;
}

.btn-primary:active {
  background: #67e8f9;
}

.btn-ghost {
  border: 1rpx solid rgba(34, 211, 238, 0.28);
  background: rgba(34, 211, 238, 0.07);
  color: #a5f3fc;
}

.btn-ghost:active {
  background: rgba(34, 211, 238, 0.14);
}

.btn-small {
  height: 56rpx;
  padding: 0 20rpx;
  font-size: 19rpx;
}

.is-disabled {
  opacity: 0.55;
}

/* Bottom nav */
.bottom-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 25;
  display: flex;
  align-items: stretch;
  height: calc(116rpx + env(safe-area-inset-bottom));
  padding: 8rpx 18rpx env(safe-area-inset-bottom);
  background: rgba(5, 7, 12, 0.78);
  border-top: 1rpx solid rgba(148, 163, 184, 0.12);
  backdrop-filter: blur(30rpx) saturate(140%);
  -webkit-backdrop-filter: blur(30rpx) saturate(140%);
}

.bottom-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  opacity: 0.9;
}

.bottom-item.active {
  color: #22d3ee;
  opacity: 1;
}

.bottom-icon {
  font-size: 36rpx;
  line-height: 1;
}

.bottom-label {
  margin-top: 6rpx;
  font-size: 18rpx;
}

/* Settings sheet */
.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 50;
  background: rgba(0, 0, 0, 0.58);
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: #0b111c;
  border-top: 1rpx solid rgba(148, 163, 184, 0.16);
  animation: slideUp 0.22s ease-out;
}

.sheet-head {
  display: flex;
  align-items: flex-start;
}

.sheet-title-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.sheet-kicker {
  color: #5b6b82;
  font-size: 14rpx;
  letter-spacing: 2rpx;
}

.sheet-title {
  margin-top: 6rpx;
  color: #e6edf7;
  font-size: 34rpx;
  font-weight: 600;
}

.sheet-sub {
  margin-top: 6rpx;
  color: #8b9bb4;
  font-size: 18rpx;
  line-height: 1.5;
}

.sheet-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(148, 163, 184, 0.08);
  color: #8b9bb4;
  font-size: 34rpx;
  text-align: center;
  line-height: 52rpx;
}

.field {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
}

.field-label {
  color: #5b6b82;
  font-size: 18rpx;
  margin-bottom: 8rpx;
}

.field-input {
  height: 82rpx;
  padding: 0 20rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  border-radius: 16rpx;
  background: rgba(148, 163, 184, 0.05);
  color: #e6edf7;
  font-size: 21rpx;
}

.sheet-hint {
  display: block;
  margin-top: 14rpx;
  color: #5b6b82;
  font-size: 17rpx;
  line-height: 1.5;
}

.sheet-actions {
  display: flex;
  margin-top: 20rpx;
}

.sheet-actions button {
  flex: 1;
}

.sheet-actions button:first-child {
  margin-right: 12rpx;
}

/* Family messages */
.chip-sedentary {
  color: #fbbf24;
  background: rgba(251, 191, 36, 0.1);
}

.message-list {
  margin-top: 16rpx;
}

.message-row {
  display: flex;
  align-items: flex-start;
  padding: 14rpx;
  margin-bottom: 10rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.1);
  border-radius: 16rpx;
  background: rgba(148, 163, 184, 0.04);
}

.message-row.parent {
  border-color: rgba(34, 211, 238, 0.14);
  background: rgba(34, 211, 238, 0.035);
}

.message-row.child {
  border-color: rgba(251, 191, 36, 0.14);
  background: rgba(251, 191, 36, 0.03);
}

.message-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(34, 211, 238, 0.3);
  background: rgba(34, 211, 238, 0.1);
  color: #a5f3fc;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  margin-right: 12rpx;
}

.message-avatar.child {
  border-color: rgba(251, 191, 36, 0.3);
  background: rgba(251, 191, 36, 0.1);
  color: #fde68a;
}

.message-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.message-head {
  display: flex;
  align-items: center;
}

.message-author {
  color: #e6edf7;
  font-size: 21rpx;
  font-weight: 600;
}

.message-role-tag {
  margin-left: 8rpx;
  padding: 2rpx 8rpx;
  border-radius: 999rpx;
  background: rgba(148, 163, 184, 0.08);
  color: #5b6b82;
  font-size: 14rpx;
}

.message-time {
  margin-left: auto;
  color: #5b6b82;
  font-size: 16rpx;
}

.message-content {
  margin-top: 6rpx;
  color: #8b9bb4;
  font-size: 20rpx;
  line-height: 1.55;
  word-break: break-all;
}

.message-delivered {
  margin-top: 6rpx;
  color: #5b6b82;
  font-size: 15rpx;
}

.message-role-row {
  display: flex;
  margin-top: 18rpx;
}

.message-role {
  flex: 1;
  margin-right: 10rpx;
  padding: 10rpx 0;
  border: 1rpx solid rgba(148, 163, 184, 0.14);
  border-radius: 12rpx;
  background: rgba(148, 163, 184, 0.04);
  color: #8b9bb4;
  font-size: 18rpx;
  text-align: center;
}

.message-role:last-child {
  margin-right: 0;
}

.message-role.active {
  border-color: rgba(34, 211, 238, 0.38);
  background: rgba(34, 211, 238, 0.1);
  color: #a5f3fc;
}

.message-textarea {
  width: 100%;
  height: 150rpx;
  margin-top: 14rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  border-radius: 14rpx;
  background: rgba(148, 163, 184, 0.05);
  color: #e6edf7;
  font-size: 20rpx;
  line-height: 1.5;
}

.message-compose-foot {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.message-count {
  color: #5b6b82;
  font-size: 16rpx;
}

.message-compose-foot .btn-primary {
  margin-left: auto;
}

.message-hint {
  display: block;
  margin-top: 12rpx;
  color: #5b6b82;
  font-size: 15rpx;
  line-height: 1.5;
}
