CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16MB.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Console on the native USB Serial/JTAG (the board's UART bridge is not usable here)
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# Halt on panic so the backtrace is not lost in a reboot loop
CONFIG_ESP_SYSTEM_PANIC_PRINT_HALT=y
# CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT is not set

CONFIG_ESP_BOARD_PERIPH_I2S_SUPPORT=y
# USB UVC camera is replaced by the wired OV2640 on DVP; only one camera is supported.
# CONFIG_ESP_VIDEO_ENABLE_USB_UVC_VIDEO_DEVICE is not set
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1024

# Camera: OV2640 over DVP 8-bit, self-clocked module (no XCLK from the SoC)
CONFIG_ESP_BOARD_DEV_CAMERA_SUPPORT=y
CONFIG_ESP_VIDEO_ENABLE_DVP_VIDEO_DEVICE=y
CONFIG_CAMERA_OV2640=y
CONFIG_CAMERA_OV2640_AUTO_DETECT_DVP_INTERFACE_SENSOR=y
CONFIG_CAMERA_OV2640_DVP_JPEG_640X480_25FPS=y
CONFIG_CAMERA_OV2640_DVP_JPEG_320X240_50FPS=y
CONFIG_CAMERA_OV2640_DVP_YUV422_YUYV_640X480_6FPS=y
# CONFIG_CAMERA_OV2640_DVP_DEFAULT_FMT_JPEG_640X480_25FPS is not set
CONFIG_CAMERA_OV2640_DVP_DEFAULT_FMT_JPEG_320X240_50FPS=y
# CONFIG_CAMERA_OV2640_DVP_DEFAULT_FMT_YUV422_YUYV_640X480_6FPS is not set

CONFIG_APP_CLAW_LUA_MODULE_CAMERA=y
CONFIG_APP_CLAW_LUA_MODULE_IOTDA=y

CONFIG_APP_CLAW_LUA_MODULE_ENVIRONMENTAL_SENSOR=y
CONFIG_LUA_MODULE_ENVIRONMENTAL_SENSOR_BACKEND_BME690=n
CONFIG_LUA_MODULE_ENVIRONMENTAL_SENSOR_BACKEND_DHT=y

# esp32-camera (camera_snapshot): reuse the board-managed I2C bus (port 0) for SCCB
CONFIG_OV2640_SUPPORT=y
CONFIG_SCCB_HARDWARE_I2C_DRIVER_NEW=y
CONFIG_SCCB_HARDWARE_I2C_PORT0=y
# CONFIG_SCCB_HARDWARE_I2C_PORT1 is not set
CONFIG_SCCB_CLK_FREQ=100000

# Camera task on core 0; snapshot waits one display frame first
CONFIG_CAMERA_CORE0=y
# CONFIG_CAMERA_CORE1 is not set
